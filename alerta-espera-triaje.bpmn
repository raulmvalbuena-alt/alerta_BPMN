<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_AlertaTriaje" targetNamespace="http://hqs.example/command-center" exporter="Claude" exporterVersion="1.0">
<bpmn:collaboration id="Collab"><bpmn:participant id="Pool" name="Alerta espera hasta triaje · HQS del Vallès" processRef="Proc_AlertaTriaje"/></bpmn:collaboration>
<bpmn:process id="Proc_AlertaTriaje" name="Alerta espera hasta triaje" isExecutable="false">
<bpmn:laneSet id="LaneSet">
<bpmn:lane id="Lane_L1" name="Primera línea"><bpmn:flowNodeRef>U1</bpmn:flowNodeRef><bpmn:flowNodeRef>B1</bpmn:flowNodeRef><bpmn:flowNodeRef>GW3</bpmn:flowNodeRef><bpmn:flowNodeRef>U2</bpmn:flowNodeRef><bpmn:flowNodeRef>U3</bpmn:flowNodeRef><bpmn:flowNodeRef>E3</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_CC" name="Command Center"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>T1</bpmn:flowNodeRef><bpmn:flowNodeRef>GW1</bpmn:flowNodeRef><bpmn:flowNodeRef>E0</bpmn:flowNodeRef><bpmn:flowNodeRef>GW2</bpmn:flowNodeRef><bpmn:flowNodeRef>E1</bpmn:flowNodeRef><bpmn:flowNodeRef>T2</bpmn:flowNodeRef><bpmn:flowNodeRef>T3</bpmn:flowNodeRef><bpmn:flowNodeRef>T4</bpmn:flowNodeRef><bpmn:flowNodeRef>E2</bpmn:flowNodeRef><bpmn:flowNodeRef>IT1</bpmn:flowNodeRef><bpmn:flowNodeRef>T5</bpmn:flowNodeRef><bpmn:flowNodeRef>GW4</bpmn:flowNodeRef><bpmn:flowNodeRef>IT2</bpmn:flowNodeRef><bpmn:flowNodeRef>T7</bpmn:flowNodeRef><bpmn:flowNodeRef>T8</bpmn:flowNodeRef><bpmn:flowNodeRef>T9</bpmn:flowNodeRef><bpmn:flowNodeRef>GW6</bpmn:flowNodeRef><bpmn:flowNodeRef>T10</bpmn:flowNodeRef><bpmn:flowNodeRef>T11</bpmn:flowNodeRef><bpmn:flowNodeRef>T12</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_L3" name="Jefatura de Urgencias"><bpmn:flowNodeRef>U4</bpmn:flowNodeRef><bpmn:flowNodeRef>B2</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_L4" name="Dirección"><bpmn:flowNodeRef>U5</bpmn:flowNodeRef><bpmn:flowNodeRef>B3</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="Start" name="Cada minuto"><bpmn:timerEventDefinition><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT1M</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:startEvent>
<bpmn:serviceTask id="T1" name="Calcular espera hasta triaje"></bpmn:serviceTask>
<bpmn:exclusiveGateway id="GW1" name="¿Supera umbral?"></bpmn:exclusiveGateway>
<bpmn:endEvent id="E0" name="Sin alerta"></bpmn:endEvent>
<bpmn:exclusiveGateway id="GW2" name="¿Se mantiene 5 min?"></bpmn:exclusiveGateway>
<bpmn:endEvent id="E1" name="Descartada"></bpmn:endEvent>
<bpmn:businessRuleTask id="T2" name="Elegir nivel y destinatarios según turno"></bpmn:businessRuleTask>
<bpmn:sendTask id="T3" name="Enviar aviso por WhatsApp"></bpmn:sendTask>
<bpmn:userTask id="U1" name="Valorar aviso"></bpmn:userTask>
<bpmn:boundaryEvent id="B1" name="10 min" attachedToRef="U1" cancelActivity="true"><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT10M</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:exclusiveGateway id="GW3" name="¿Decisión?"></bpmn:exclusiveGateway>
<bpmn:userTask id="U2" name="Aplicar medida (abrir box, reasignar)"></bpmn:userTask>
<bpmn:serviceTask id="T4" name="Registrar motivo y bloquear 60 min"></bpmn:serviceTask>
<bpmn:endEvent id="E2" name="Anulada"></bpmn:endEvent>
<bpmn:intermediateCatchEvent id="IT1" name="Silencio 20 min"><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT20M</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
<bpmn:serviceTask id="T5" name="Reevaluar indicadores"></bpmn:serviceTask>
<bpmn:exclusiveGateway id="GW4" name="¿Resultado?"></bpmn:exclusiveGateway>
<bpmn:intermediateCatchEvent id="IT2" name="Seguimiento 5 min"><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
<bpmn:serviceTask id="T7" name="Cerrar alerta"></bpmn:serviceTask>
<bpmn:sendTask id="T8" name="Solicitar feedback"></bpmn:sendTask>
<bpmn:userTask id="U3" name="Responder feedback"></bpmn:userTask>
<bpmn:endEvent id="E3" name="Cerrada"></bpmn:endEvent>
<bpmn:serviceTask id="T9" name="Reactivar alerta"></bpmn:serviceTask>
<bpmn:exclusiveGateway id="GW6" name="¿2.ª reactivación?"></bpmn:exclusiveGateway>
<bpmn:sendTask id="T10" name="Escalar a Jefatura"></bpmn:sendTask>
<bpmn:userTask id="U4" name="Valorar y activar refuerzo"></bpmn:userTask>
<bpmn:boundaryEvent id="B2" name="10 min" attachedToRef="U4" cancelActivity="true"><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT10M</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:sendTask id="T11" name="Escalar a Dirección"></bpmn:sendTask>
<bpmn:userTask id="U5" name="Valorar y activar refuerzo"></bpmn:userTask>
<bpmn:boundaryEvent id="B3" name="10 min" attachedToRef="U5" cancelActivity="true"><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT10M</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:sendTask id="T12" name="Registrar incidencia y repetir aviso cada 30 min"></bpmn:sendTask>
<bpmn:sequenceFlow id="f1" sourceRef="Start" targetRef="T1"/>
<bpmn:sequenceFlow id="f2" sourceRef="T1" targetRef="GW1"/>
<bpmn:sequenceFlow id="f3" sourceRef="GW1" targetRef="GW2" name="Sí"/>
<bpmn:sequenceFlow id="f4" sourceRef="GW1" targetRef="E0" name="No"/>
<bpmn:sequenceFlow id="f5" sourceRef="GW2" targetRef="T2" name="Sí"/>
<bpmn:sequenceFlow id="f6" sourceRef="GW2" targetRef="E1" name="No"/>
<bpmn:sequenceFlow id="f7" sourceRef="T2" targetRef="T3"/>
<bpmn:sequenceFlow id="f8" sourceRef="T3" targetRef="U1"/>
<bpmn:sequenceFlow id="f9" sourceRef="U1" targetRef="GW3"/>
<bpmn:sequenceFlow id="f10" sourceRef="GW3" targetRef="U2" name="Asume"/>
<bpmn:sequenceFlow id="f11" sourceRef="GW3" targetRef="T4" name="Anula con motivo"/>
<bpmn:sequenceFlow id="f12" sourceRef="T4" targetRef="E2"/>
<bpmn:sequenceFlow id="f13" sourceRef="U2" targetRef="IT1"/>
<bpmn:sequenceFlow id="f14" sourceRef="IT1" targetRef="T5"/>
<bpmn:sequenceFlow id="f15" sourceRef="T5" targetRef="GW4"/>
<bpmn:sequenceFlow id="f16" sourceRef="GW4" targetRef="T7" name="Estable"/>
<bpmn:sequenceFlow id="f17" sourceRef="GW4" targetRef="IT2" name="Mejora"/>
<bpmn:sequenceFlow id="f18" sourceRef="IT2" targetRef="T5"/>
<bpmn:sequenceFlow id="f19" sourceRef="GW4" targetRef="T9" name="Igual o peor"/>
<bpmn:sequenceFlow id="f20" sourceRef="T7" targetRef="T8"/>
<bpmn:sequenceFlow id="f21" sourceRef="T8" targetRef="U3"/>
<bpmn:sequenceFlow id="f22" sourceRef="U3" targetRef="E3"/>
<bpmn:sequenceFlow id="f23" sourceRef="T9" targetRef="GW6"/>
<bpmn:sequenceFlow id="f24" sourceRef="GW6" targetRef="T3" name="No · nuevo aviso"/>
<bpmn:sequenceFlow id="f25" sourceRef="GW6" targetRef="T10" name="Sí"/>
<bpmn:sequenceFlow id="f26" sourceRef="B1" targetRef="T10"/>
<bpmn:sequenceFlow id="f27" sourceRef="T10" targetRef="U4"/>
<bpmn:sequenceFlow id="f28" sourceRef="U4" targetRef="IT1"/>
<bpmn:sequenceFlow id="f29" sourceRef="B2" targetRef="T11"/>
<bpmn:sequenceFlow id="f30" sourceRef="T11" targetRef="U5"/>
<bpmn:sequenceFlow id="f31" sourceRef="U5" targetRef="IT1"/>
<bpmn:sequenceFlow id="f32" sourceRef="B3" targetRef="T12"/>
<bpmn:sequenceFlow id="f33" sourceRef="T12" targetRef="U5"/>
<bpmn:textAnnotation id="A1"><bpmn:text>Amarillo: mediana ≥ 15 min o ≥ 10 pacientes esperando. Rojo: un paciente ≥ 30 min sin triar.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="As_A1" sourceRef="A1" targetRef="GW1"/>
<bpmn:textAnnotation id="A2"><bpmn:text>Laborable 8–22 h: supervisora de Urgencias (+ médico adjunto si es rojo). Noche y festivos: supervisora y médico de guardia. Máximo 3 avisos por persona y hora.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="As_A2" sourceRef="A2" targetRef="T2"/>
<bpmn:textAnnotation id="A3"><bpmn:text>Si pasa a rojo, se informa al médico sin pedir acuse. Si los indicadores se normalizan 10 min, se cierra antes.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="As_A3" sourceRef="A3" targetRef="IT1"/>
<bpmn:textAnnotation id="A4"><bpmn:text>También escala a Dirección si lleva 60 min seguidos en rojo. Jefatura y Dirección pueden anular con motivo.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="A5"><bpmn:text>El feedback lo responde quien asumió la alerta (primera línea, Jefatura o Dirección).</bpmn:text></bpmn:textAnnotation>
</bpmn:process>
