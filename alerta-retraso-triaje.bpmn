<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_AlertaTriaje" targetNamespace="http://hqs.example/command-center" exporter="Claude" exporterVersion="1.0">
<bpmn:collaboration id="Collab"><bpmn:participant id="Pool" name="Retraso en triaje por alta demanda · Urgencias adultos · HQS del Vallès" processRef="Proc_AlertaTriaje"/></bpmn:collaboration>
<bpmn:process id="Proc_AlertaTriaje" name="Alerta retraso en triaje" isExecutable="false">
<bpmn:laneSet id="LaneSet">
<bpmn:lane id="Lane_L1" name="Dinamizadora y responsable de enfermería"><bpmn:flowNodeRef>U1</bpmn:flowNodeRef><bpmn:flowNodeRef>Brem</bpmn:flowNodeRef><bpmn:flowNodeRef>Trem</bpmn:flowNodeRef><bpmn:flowNodeRef>Erem</bpmn:flowNodeRef><bpmn:flowNodeRef>Besc</bpmn:flowNodeRef><bpmn:flowNodeRef>GW3</bpmn:flowNodeRef><bpmn:flowNodeRef>U2</bpmn:flowNodeRef><bpmn:flowNodeRef>U3</bpmn:flowNodeRef><bpmn:flowNodeRef>E3</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_CC" name="Command Center"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>T1</bpmn:flowNodeRef><bpmn:flowNodeRef>GW1</bpmn:flowNodeRef><bpmn:flowNodeRef>E0</bpmn:flowNodeRef><bpmn:flowNodeRef>GW2</bpmn:flowNodeRef><bpmn:flowNodeRef>E1</bpmn:flowNodeRef><bpmn:flowNodeRef>GW7</bpmn:flowNodeRef><bpmn:flowNodeRef>Tinf</bpmn:flowNodeRef><bpmn:flowNodeRef>Einf</bpmn:flowNodeRef><bpmn:flowNodeRef>T3</bpmn:flowNodeRef><bpmn:flowNodeRef>T4</bpmn:flowNodeRef><bpmn:flowNodeRef>E2</bpmn:flowNodeRef><bpmn:flowNodeRef>IT1</bpmn:flowNodeRef><bpmn:flowNodeRef>T5</bpmn:flowNodeRef><bpmn:flowNodeRef>GW4</bpmn:flowNodeRef><bpmn:flowNodeRef>T7</bpmn:flowNodeRef><bpmn:flowNodeRef>T8</bpmn:flowNodeRef><bpmn:flowNodeRef>GW8</bpmn:flowNodeRef><bpmn:flowNodeRef>T9</bpmn:flowNodeRef><bpmn:flowNodeRef>T10</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_L3" name="Dirección de Enfermería"><bpmn:flowNodeRef>U4</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="Start" name="Cada minuto"><bpmn:timerEventDefinition><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT1M</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:startEvent>
<bpmn:serviceTask id="T1" name="Calcular mediana de espera hasta triaje"></bpmn:serviceTask>
<bpmn:exclusiveGateway id="GW1" name="¿Mediana &gt; 6 min?"></bpmn:exclusiveGateway>
<bpmn:endEvent id="E0" name="Sin alerta"></bpmn:endEvent>
<bpmn:exclusiveGateway id="GW2" name="¿Se mantiene 2 min?"></bpmn:exclusiveGateway>
<bpmn:endEvent id="E1" name="Descartada"></bpmn:endEvent>
<bpmn:exclusiveGateway id="GW7" name="¿Pacientes esperando?"></bpmn:exclusiveGateway>
<bpmn:sendTask id="Tinf" name="Enviar aviso informativo"></bpmn:sendTask>
<bpmn:endEvent id="Einf" name="Informada"></bpmn:endEvent>
<bpmn:sendTask id="T3" name="Enviar alerta por WhatsApp"></bpmn:sendTask>
<bpmn:userTask id="U1" name="Valorar alerta"></bpmn:userTask>
<bpmn:boundaryEvent id="Brem" name="Recordatorio 5 min" attachedToRef="U1" cancelActivity="false"><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:sendTask id="Trem" name="Repetir aviso"></bpmn:sendTask>
<bpmn:endEvent id="Erem" name="Recordado"></bpmn:endEvent>
<bpmn:boundaryEvent id="Besc" name="20 min" attachedToRef="U1" cancelActivity="true"><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT20M</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:exclusiveGateway id="GW3" name="¿Decisión?"></bpmn:exclusiveGateway>
<bpmn:userTask id="U2" name="Acudir a la sala y priorizar triaje"></bpmn:userTask>
<bpmn:serviceTask id="T4" name="Registrar motivo y bloquear 60 min"></bpmn:serviceTask>
<bpmn:endEvent id="E2" name="Anulada"></bpmn:endEvent>
<bpmn:intermediateCatchEvent id="IT1" name="Silencio 10 min"><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT10M</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
<bpmn:serviceTask id="T5" name="Reevaluar mediana"></bpmn:serviceTask>
<bpmn:exclusiveGateway id="GW4" name="¿Resultado?"></bpmn:exclusiveGateway>
<bpmn:serviceTask id="T7" name="Cerrar alerta"></bpmn:serviceTask>
<bpmn:sendTask id="T8" name="Solicitar feedback"></bpmn:sendTask>
<bpmn:userTask id="U3" name="Responder feedback"></bpmn:userTask>
<bpmn:endEvent id="E3" name="Cerrada"></bpmn:endEvent>
<bpmn:exclusiveGateway id="GW8" name="¿Sostenida 20 min?"></bpmn:exclusiveGateway>
<bpmn:serviceTask id="T9" name="Reactivar alerta"></bpmn:serviceTask>
<bpmn:sendTask id="T10" name="Escalar a Dirección de Enfermería"></bpmn:sendTask>
<bpmn:userTask id="U4" name="Valorar y enviar refuerzo"></bpmn:userTask>
<bpmn:sequenceFlow id="f1" sourceRef="Start" targetRef="T1"/>
<bpmn:sequenceFlow id="f2" sourceRef="T1" targetRef="GW1"/>
<bpmn:sequenceFlow id="f3" sourceRef="GW1" targetRef="GW2" name="Sí"/>
<bpmn:sequenceFlow id="f4" sourceRef="GW1" targetRef="E0" name="No"/>
<bpmn:sequenceFlow id="f5" sourceRef="GW2" targetRef="GW7" name="Sí"/>
<bpmn:sequenceFlow id="f6" sourceRef="GW2" targetRef="E1" name="No"/>
<bpmn:sequenceFlow id="f7" sourceRef="GW7" targetRef="T3" name="Más de 3"/>
<bpmn:sequenceFlow id="f8" sourceRef="GW7" targetRef="Tinf" name="3 o menos"/>
<bpmn:sequenceFlow id="f9" sourceRef="Tinf" targetRef="Einf"/>
<bpmn:sequenceFlow id="f10" sourceRef="T3" targetRef="U1"/>
<bpmn:sequenceFlow id="f11" sourceRef="U1" targetRef="GW3"/>
<bpmn:sequenceFlow id="f12" sourceRef="GW3" targetRef="U2" name="Asume"/>
<bpmn:sequenceFlow id="f13" sourceRef="GW3" targetRef="T4" name="Anula con motivo"/>
<bpmn:sequenceFlow id="f14" sourceRef="T4" targetRef="E2"/>
<bpmn:sequenceFlow id="f15" sourceRef="U2" targetRef="IT1"/>
<bpmn:sequenceFlow id="f16" sourceRef="IT1" targetRef="T5"/>
<bpmn:sequenceFlow id="f17" sourceRef="T5" targetRef="GW4"/>
<bpmn:sequenceFlow id="f18" sourceRef="GW4" targetRef="T7" name="Normalizada 5 min"/>
<bpmn:sequenceFlow id="f19" sourceRef="GW4" targetRef="GW8" name="Persiste"/>
<bpmn:sequenceFlow id="f20" sourceRef="GW8" targetRef="T9" name="No"/>
<bpmn:sequenceFlow id="f21" sourceRef="GW8" targetRef="T10" name="Sí"/>
<bpmn:sequenceFlow id="f22" sourceRef="T9" targetRef="T3" name="Nuevo aviso"/>
<bpmn:sequenceFlow id="f23" sourceRef="T7" targetRef="T8"/>
<bpmn:sequenceFlow id="f24" sourceRef="T8" targetRef="U3"/>
<bpmn:sequenceFlow id="f25" sourceRef="U3" targetRef="E3"/>
<bpmn:sequenceFlow id="f26" sourceRef="Besc" targetRef="T10"/>
<bpmn:sequenceFlow id="f27" sourceRef="T10" targetRef="U4"/>
<bpmn:sequenceFlow id="f28" sourceRef="U4" targetRef="IT1"/>
<bpmn:sequenceFlow id="f29" sourceRef="Brem" targetRef="Trem"/>
<bpmn:sequenceFlow id="f30" sourceRef="Trem" targetRef="Erem"/>
<bpmn:textAnnotation id="A1"><bpmn:text>Alerta: mediana de espera &gt; 6 min con más de 3 pacientes. Con 3 o menos, aviso informativo.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="As_A1" sourceRef="A1" targetRef="GW1"/>
<bpmn:textAnnotation id="A2"><bpmn:text>Informativo: sin acuse ni escalado. Si pasan de 3 pacientes, se convierte en alerta.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="As_A2" sourceRef="A2" targetRef="Tinf"/>
<bpmn:textAnnotation id="A3"><bpmn:text>WhatsApp a la dinamizadora (acude a la sala) y a la responsable de enfermería de Urgencias.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="A4"><bpmn:text>Si Dirección de Enfermería no responde, queda como incidencia y se repite el aviso cada 30 min.</bpmn:text></bpmn:textAnnotation>
</bpmn:process>
