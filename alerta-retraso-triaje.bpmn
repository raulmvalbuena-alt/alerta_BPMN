<bpmn:collaboration id="Collab"><bpmn:participant id="Pool" name="Retraso en triaje por alta demanda · Urgencias adultos · HQS del Vallès" processRef="Proc_AlertaTriaje"/></bpmn:collaboration>
<bpmn:process id="Proc_AlertaTriaje" name="Alerta retraso en triaje" isExecutable="false">
<bpmn:laneSet id="LaneSet">
<bpmn:lane id="Lane_L1" name="Dinamizadora"><bpmn:flowNodeRef>U1</bpmn:flowNodeRef><bpmn:flowNodeRef>B5</bpmn:flowNodeRef><bpmn:flowNodeRef>U3</bpmn:flowNodeRef><bpmn:flowNodeRef>E3</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_L2" name="Responsable de enfermería de Urgencias"><bpmn:flowNodeRef>U1b</bpmn:flowNodeRef><bpmn:flowNodeRef>B20</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_CC" name="Command Center"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>T1</bpmn:flowNodeRef><bpmn:flowNodeRef>GW1</bpmn:flowNodeRef><bpmn:flowNodeRef>E0</bpmn:flowNodeRef><bpmn:flowNodeRef>GW2</bpmn:flowNodeRef><bpmn:flowNodeRef>E1</bpmn:flowNodeRef><bpmn:flowNodeRef>GW7</bpmn:flowNodeRef><bpmn:flowNodeRef>Tinf</bpmn:flowNodeRef><bpmn:flowNodeRef>EBG</bpmn:flowNodeRef><bpmn:flowNodeRef>Cnorm</bpmn:flowNodeRef><bpmn:flowNodeRef>Einf</bpmn:flowNodeRef><bpmn:flowNodeRef>Cup</bpmn:flowNodeRef><bpmn:flowNodeRef>Ttim</bpmn:flowNodeRef><bpmn:flowNodeRef>T3</bpmn:flowNodeRef><bpmn:flowNodeRef>GW3</bpmn:flowNodeRef><bpmn:flowNodeRef>T4</bpmn:flowNodeRef><bpmn:flowNodeRef>E2</bpmn:flowNodeRef><bpmn:flowNodeRef>IT1</bpmn:flowNodeRef><bpmn:flowNodeRef>T5</bpmn:flowNodeRef><bpmn:flowNodeRef>GW4</bpmn:flowNodeRef><bpmn:flowNodeRef>T7</bpmn:flowNodeRef><bpmn:flowNodeRef>T8</bpmn:flowNodeRef><bpmn:flowNodeRef>GW8</bpmn:flowNodeRef><bpmn:flowNodeRef>T9</bpmn:flowNodeRef><bpmn:flowNodeRef>T10</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_L3" name="Dirección de Enfermería"><bpmn:flowNodeRef>U4</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="Start" name="Cada minuto"><bpmn:timerEventDefinition><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT1M</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:startEvent>
<bpmn:serviceTask id="T1" name="Calcular mediana y espera más larga"></bpmn:serviceTask>
<bpmn:exclusiveGateway id="GW1" name="¿Supera umbral?"></bpmn:exclusiveGateway>
<bpmn:endEvent id="E0" name="Sin alerta"></bpmn:endEvent>
<bpmn:exclusiveGateway id="GW2" name="¿Se mantiene 2 min?"></bpmn:exclusiveGateway>
<bpmn:endEvent id="E1" name="Descartada"></bpmn:endEvent>
<bpmn:exclusiveGateway id="GW7" name="¿Tipo?"></bpmn:exclusiveGateway>
<bpmn:sendTask id="Tinf" name="Enviar aviso informativo"></bpmn:sendTask>
<bpmn:eventBasedGateway id="EBG" name=""></bpmn:eventBasedGateway>
<bpmn:intermediateCatchEvent id="Cnorm" name="Mediana ≤ 5 min durante 5 min"><bpmn:conditionalEventDefinition><bpmn:condition xsi:type="bpmn:tFormalExpression">mediana &lt;= 5 durante 5 min</bpmn:condition></bpmn:conditionalEventDefinition></bpmn:intermediateCatchEvent>
<bpmn:endEvent id="Einf" name="Cerrada sin intervención"></bpmn:endEvent>
<bpmn:intermediateCatchEvent id="Cup" name="Más de 3 o uno &gt; 15 min"><bpmn:conditionalEventDefinition><bpmn:condition xsi:type="bpmn:tFormalExpression">pacientes &gt; 3 o espera maxima &gt; 15</bpmn:condition></bpmn:conditionalEventDefinition></bpmn:intermediateCatchEvent>
<bpmn:intermediateCatchEvent id="Ttim" name="Dura 15 min"><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT15M</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
<bpmn:sendTask id="T3" name="Enviar alerta a la dinamizadora"></bpmn:sendTask>
<bpmn:userTask id="U1" name="Valorar alerta"></bpmn:userTask>
<bpmn:boundaryEvent id="B5" name="5 min sin acuse" attachedToRef="U1" cancelActivity="true"><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:userTask id="U1b" name="Valorar alerta"></bpmn:userTask>
<bpmn:boundaryEvent id="B20" name="Sostenida 20 min" attachedToRef="U1b" cancelActivity="true"><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT15M</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:exclusiveGateway id="GW3" name="¿Respuesta?"></bpmn:exclusiveGateway>
<bpmn:serviceTask id="T4" name="Registrar motivo y bloquear 60 min"></bpmn:serviceTask>
<bpmn:endEvent id="E2" name="Anulada"></bpmn:endEvent>
<bpmn:intermediateCatchEvent id="IT1" name="Silencio 10 min"><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT10M</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
<bpmn:serviceTask id="T5" name="Reevaluar"></bpmn:serviceTask>
<bpmn:exclusiveGateway id="GW4" name="¿Resultado?"></bpmn:exclusiveGateway>
<bpmn:serviceTask id="T7" name="Cerrar alerta"></bpmn:serviceTask>
<bpmn:sendTask id="T8" name="Solicitar feedback"></bpmn:sendTask>
<bpmn:userTask id="U3" name="Responder feedback"></bpmn:userTask>
<bpmn:endEvent id="E3" name="Cerrada"></bpmn:endEvent>
<bpmn:exclusiveGateway id="GW8" name="¿Sostenida 20 min?"></bpmn:exclusiveGateway>
<bpmn:sendTask id="T9" name="Reactivar y volver a avisar"></bpmn:sendTask>
<bpmn:sendTask id="T10" name="Escalar a Dirección de Enfermería"></bpmn:sendTask>
<bpmn:userTask id="U4" name="Valorar y enviar refuerzo"></bpmn:userTask>
<bpmn:sequenceFlow id="f1" sourceRef="Start" targetRef="T1"/>
<bpmn:sequenceFlow id="f2" sourceRef="T1" targetRef="GW1"/>
<bpmn:sequenceFlow id="f3" sourceRef="GW1" targetRef="GW2" name="Sí"/>
<bpmn:sequenceFlow id="f4" sourceRef="GW1" targetRef="E0" name="No"/>
<bpmn:sequenceFlow id="f5" sourceRef="GW2" targetRef="GW7" name="Sí"/>
<bpmn:sequenceFlow id="f6" sourceRef="GW2" targetRef="E1" name="No"/>
<bpmn:sequenceFlow id="f7" sourceRef="GW7" targetRef="T3" name="Alerta"/>
<bpmn:sequenceFlow id="f8" sourceRef="GW7" targetRef="Tinf" name="Informativa"/>
<bpmn:sequenceFlow id="f9" sourceRef="Tinf" targetRef="EBG"/>
<bpmn:sequenceFlow id="f10" sourceRef="EBG" targetRef="Cnorm"/>
<bpmn:sequenceFlow id="f11" sourceRef="Cnorm" targetRef="Einf"/>
<bpmn:sequenceFlow id="f12" sourceRef="EBG" targetRef="Cup"/>
<bpmn:sequenceFlow id="f13" sourceRef="EBG" targetRef="Ttim"/>
<bpmn:sequenceFlow id="f14" sourceRef="Cup" targetRef="T3"/>
<bpmn:sequenceFlow id="f15" sourceRef="Ttim" targetRef="T3"/>
<bpmn:sequenceFlow id="f16" sourceRef="T3" targetRef="U1"/>
<bpmn:sequenceFlow id="f17" sourceRef="B5" targetRef="U1b" name="Avisar a la responsable"/>
<bpmn:sequenceFlow id="f18" sourceRef="U1" targetRef="GW3"/>
<bpmn:sequenceFlow id="f19" sourceRef="U1b" targetRef="GW3"/>
<bpmn:sequenceFlow id="f20" sourceRef="GW3" targetRef="IT1" name="Asume"/>
<bpmn:sequenceFlow id="f21" sourceRef="GW3" targetRef="T4" name="Anula con motivo"/>
<bpmn:sequenceFlow id="f22" sourceRef="T4" targetRef="E2"/>
<bpmn:sequenceFlow id="f23" sourceRef="IT1" targetRef="T5"/>
<bpmn:sequenceFlow id="f24" sourceRef="T5" targetRef="GW4"/>
<bpmn:sequenceFlow id="f25" sourceRef="GW4" targetRef="T7" name="Cierre 5 min"/>
<bpmn:sequenceFlow id="f26" sourceRef="GW4" targetRef="GW8" name="Persiste"/>
<bpmn:sequenceFlow id="f27" sourceRef="GW8" targetRef="T9" name="No"/>
<bpmn:sequenceFlow id="f28" sourceRef="GW8" targetRef="T10" name="Sí"/>
<bpmn:sequenceFlow id="f29" sourceRef="T9" targetRef="U1" name="Nuevo aviso"/>
<bpmn:sequenceFlow id="f30" sourceRef="B20" targetRef="T10"/>
<bpmn:sequenceFlow id="f31" sourceRef="T10" targetRef="U4"/>
<bpmn:sequenceFlow id="f32" sourceRef="U4" targetRef="IT1"/>
<bpmn:sequenceFlow id="f33" sourceRef="T7" targetRef="T8"/>
<bpmn:sequenceFlow id="f34" sourceRef="T8" targetRef="U3"/>
<bpmn:sequenceFlow id="f35" sourceRef="U3" targetRef="E3"/>
<bpmn:textAnnotation id="A1"><bpmn:text>Umbral: mediana &gt; 6 min o un paciente &gt; 15 min sin triar, durante 2 min. Alerta si hay más de 3 pacientes o alguien pasa de 15 min. Si no, informativa: a la dinamizadora y a la responsable, sin acuse.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="As_A1" sourceRef="A1" targetRef="GW1"/>
<bpmn:textAnnotation id="A3"><bpmn:text>Dueño: equipo de desarrollo · reglas v1.1 (fase 1). Destinatarios por cargo.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="A4"><bpmn:text>Si Dirección de Enfermería no responde en 5 min, queda como incidencia y se repite el aviso cada 30 min.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="A5"><bpmn:text>La dinamizadora puede asumirla también después de avisar a la responsable. Cierre con histéresis: mediana ≤ 5 min y nadie &gt; 15.</bpmn:text></bpmn:textAnnotation>
</bpmn:process>
